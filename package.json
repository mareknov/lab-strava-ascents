{
  "name": "lab-strava-ascents",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:packages && npm run build:web",
    "build:packages": "tsc -b",
    "build:web": "node tools/build-web.js",
    "dev": "node tools/build-web.js --watch --serve",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "samples": "node tools/pack-samples.js",
    "fixtures": "node tools/make-fixtures.js",
    "clean": "rm -rf packages/*/dist apps/web/dist dist .tsbuildinfo packages/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "happy-dom": "^16.3.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
